{
  "tempDir": true,
  "steps": [
    {
      // No oden.lock, package-lock.json, or pnpm-lock.yaml. `oden install`
      // should seed oden.lock from bun.lock, including the workspace member's
      // deps (bun records every workspace's requirements under `workspaces`).
      "args": "install",
      "output": "install.out"
    },
    {
      "args": [
        "eval",
        "console.log(Oden.readTextFileSync('oden.lock').trim())"
      ],
      "output": "oden.lock.out"
    }
  ]
}
