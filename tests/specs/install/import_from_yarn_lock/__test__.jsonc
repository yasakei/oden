{
  "tempDir": true,
  "steps": [
    {
      // No oden.lock, no package-lock.json, no pnpm-lock.yaml — fall back
      // to translating yarn.lock.
      "args": "install",
      "output": "install.out"
    },
    {
      "args": [
        "eval",
        "console.log(Oden.readTextFileSync('oden.lock').trim())"
      ],
      "output": "oden.lock.out"
    },
    {
      "args": "run --cached-only main.js",
      "output": "3\n"
    }
  ]
}
