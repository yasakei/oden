{
  "tempDir": true,
  "steps": [
    {
      // No oden.lock, package-lock.json, or pnpm-lock.yaml. `oden install`
      // should seed oden.lock from yarn.lock, including the workspace member's
      // deps (yarn classic flattens every workspace dependency into the single
      // root lockfile, so both packages are captured).
      "args": "install",
      "output": "install.out"
    },
    {
      "args": [
        "eval",
        "console.log(Oden.readTextFileSync('oden.lock').trim())"
      ],
      "output": "oden.lock.out"
    }
  ]
}
