{
  "tempDir": true,
  "steps": [
    {
      // No oden.lock or package-lock.json — `oden install` should seed
      // oden.lock from pnpm-lock.yaml instead.
      "args": "install",
      "output": "install.out"
    },
    {
      "args": [
        "eval",
        "console.log(Oden.readTextFileSync('oden.lock').trim())"
      ],
      "output": "oden.lock.out"
    },
    {
      "args": "run --cached-only main.js",
      "output": "3\n"
    }
  ]
}
