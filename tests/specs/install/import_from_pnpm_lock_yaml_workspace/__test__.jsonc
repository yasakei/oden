{
  "tempDir": true,
  "steps": [
    {
      // No oden.lock or package-lock.json. `oden install` should seed
      // oden.lock from pnpm-lock.yaml, including the workspace member's deps.
      "args": "install",
      "output": "install.out"
    },
    {
      "args": [
        "eval",
        "console.log(Oden.readTextFileSync('oden.lock').trim())"
      ],
      "output": "oden.lock.out"
    }
  ]
}
