{
  "tempDir": true,
  "steps": [{
    // this would only occur with a lockfile and a package with "extra info" (bin or script)
    "args": "install npm:@odentest/bin",
    "output": "[WILDCARD]"
  }, {
    "args": "run -A update.ts $ODEN_DIR",
    "output": ""
  }, {
    // should not error
    "args": "install",
    "output": "[WILDCARD]"
  }]
}
