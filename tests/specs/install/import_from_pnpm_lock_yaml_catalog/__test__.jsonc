{
  "tempDir": true,
  "steps": [
    {
      // No oden.lock or package-lock.json. `oden install` should seed
      // oden.lock from pnpm-lock.yaml, resolving the `catalog:` specifier to
      // its real version requirement via the lockfile's `catalogs:` block.
      "args": "install",
      "output": "install.out"
    },
    {
      "args": [
        "eval",
        "console.log(Oden.readTextFileSync('oden.lock').trim())"
      ],
      "output": "oden.lock.out"
    }
  ]
}
