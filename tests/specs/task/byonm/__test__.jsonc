{
  "tempDir": true,
  "tests": {
    "oden_json": {
      "steps": [{
        "commandName": "npm",
        "args": "install",
        "output": "[WILDCARD]"
      }, {
        "args": "task say",
        "output": "package_json_say.out"
      }, {
        "args": "task oden-say",
        "output": "oden_json_say.out"
      }]
    },
    "no_oden_json": {
      "steps": [{
        "args": [
          "eval",
          "Oden.removeSync('oden.json')"
        ],
        "output": ""
      }, {
        "commandName": "npm",
        "args": "install",
        "output": "[WILDCARD]"
      }, {
        "args": "task say",
        "output": "package_json_say.out"
      }, {
        // byonm flag
        "args": "task --unstable-byonm say",
        "output": "package_json_say.out"
      }, {
        "args": [
          "eval",
          "try { Oden.statSync('node_modules/.oden'); } catch (e) { if (e instanceof Oden.errors.NotFound) { console.log('good'); } else { throw new Error('bad'); } }"
        ],
        "output": "good\n"
      }]
    }
  }
}
