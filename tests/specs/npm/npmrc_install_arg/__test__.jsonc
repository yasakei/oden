{
  "tempDir": true,
  "tests": {
    "oden_install_add": {
      "steps": [{
        "args": "install npm:@odentest/basic",
        "output": "install.out"
      }, {
        "args": "run -A main.js",
        "output": "main.out"
      }]
    },
    "oden_add": {
      "steps": [{
        "args": "add npm:@odentest/basic",
        "output": "add.out"
      }, {
        "args": "run -A main.js",
        "output": "main.out"
      }]
    }
  }
}
