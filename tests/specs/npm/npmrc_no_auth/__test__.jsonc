{
  "tempDir": true,
  "tests": {
    "oden_install_arg": {
      "steps": [{
        "args": "install npm:@odentest3/basic",
        "output": "install.out"
      }, {
        "args": "run -A main.js",
        "output": "main.out"
      }]
    },
    "oden_add_arg": {
      "steps": [{
        "args": "add npm:@odentest3/basic",
        "output": "add.out"
      }, {
        "args": "run -A main.js",
        "output": "main.out"
      }]
    }
  }
}
