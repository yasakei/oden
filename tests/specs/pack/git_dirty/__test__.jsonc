{
  "tempDir": true,
  "tests": {
    "pack_git_dirty_blocked": {
      "steps": [{
        "args": [
          "eval",
          "Oden.writeTextFileSync('oden.json', JSON.stringify({name: '@test/dirty', version: '1.0.0', exports: './mod.ts'})); Oden.writeTextFileSync('mod.ts', 'export const x = 1;');"
        ],
        "output": ""
      }, {
        "args": [
          "eval",
          "new Oden.Command('git', { args: ['init'], stdout: 'null', stderr: 'null' }).outputSync();"
        ],
        "output": ""
      }, {
        "args": "pack",
        "exitCode": 1,
        "output": "[WILDCARD]error[WILDCARD]Git repository has uncommitted changes[WILDCARD]"
      }]
    },
    "pack_git_dirty_allowed": {
      "steps": [{
        "args": [
          "eval",
          "Oden.writeTextFileSync('oden.json', JSON.stringify({name: '@test/dirty', version: '1.0.0', exports: './mod.ts'})); Oden.writeTextFileSync('mod.ts', 'export const x = 1;');"
        ],
        "output": ""
      }, {
        "args": [
          "eval",
          "new Oden.Command('git', { args: ['init'], stdout: 'null', stderr: 'null' }).outputSync();"
        ],
        "output": ""
      }, {
        "args": "pack --allow-dirty",
        "output": "[WILDCARD]✓[WILDCARD]test-dirty-1.0.0.tgz[WILDCARD]"
      }]
    }
  }
}
