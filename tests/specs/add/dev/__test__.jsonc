{
  "tempDir": true,
  "tests": {
    "package_json": {
      "steps": [
        {
          "args": "add --dev npm:@odentest/esm-basic",
          "output": "add_packagejson.out"
        },
        {
          "args": [
            "eval",
            "console.log(Oden.readTextFileSync('package.json').trim())"
          ],
          "output": "package.json.out"
        }
      ]
    },
    "oden_json": {
      "steps": [
        {
          "args": ["eval", "Oden.removeSync('package.json')"],
          "output": ""
        },
        {
          "args": "add --dev npm:@odentest/esm-basic",
          "output": "add.out"
        },
        {
          "args": [
            "eval",
            "console.log(Oden.readTextFileSync('oden.json').trim())"
          ],
          "output": "oden.json.out"
        }
      ]
    }
  }
}
