{
  "tempDir": true,
  "tests": {
    "prefers_package_json_from_config": {
      // With "preferPackageJson": true in oden.json, `oden add` (no flag)
      // routes all packages into package.json.
      "steps": [
        {
          "args": "add npm:@odentest/esm-basic jsr:@odentest/add",
          "output": "add.out"
        },
        {
          "args": [
            "eval",
            "console.log(Oden.readTextFileSync('package.json').trim())"
          ],
          "output": "package.json.out"
        },
        {
          "args": [
            "eval",
            "console.log(Oden.readTextFileSync('oden.json').trim())"
          ],
          "output": "oden.json.out"
        }
      ]
    },
    "creates_package_json_if_missing": {
      // With "preferPackageJson": true but no package.json, one is created.
      "steps": [
        {
          "args": [
            "eval",
            "Oden.removeSync('package.json')"
          ],
          "output": ""
        },
        {
          "args": "add npm:@odentest/esm-basic",
          "output": "add_create.out"
        },
        {
          "args": [
            "eval",
            "console.log(Oden.readTextFileSync('package.json').trim())"
          ],
          "output": "created_package.json.out"
        }
      ]
    }
  }
}
