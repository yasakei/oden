{
  "tempDir": true,
  "tests": {
    "npm": {
      "steps": [
        {
          "args": "add npm:@odentest/esm-basic@1.0.0",
          "output": "npm_add.out"
        },
        {
          "args": [
            "eval",
            "console.log(Oden.readTextFileSync('oden.json').trim())"
          ],
          "output": "npm_oden.json.out"
        }
      ]
    },
    "jsr": {
      "steps": [
        {
          "args": "add jsr:@odentest/add@1.0.0",
          "output": "jsr_add.out"
        },
        {
          "args": [
            "eval",
            "console.log(Oden.readTextFileSync('oden.json').trim())"
          ],
          "output": "jsr_oden.json.out"
        }
      ]
    }
  }
}
