{
  "tempDir": true,
  "tests": {
    "does_not_modify_config": {
      "steps": [
        {
          "args": "add --no-save npm:@odentest/esm-basic",
          "output": "add.out"
        },
        {
          "args": [
            "eval",
            "console.log(Oden.readTextFileSync('package.json').trim())"
          ],
          "output": "package.json.out"
        },
        {
          "args": [
            "eval",
            "console.log(Oden.readTextFileSync('oden.json').trim())"
          ],
          "output": "oden.json.out"
        },
        {
          "args": [
            "eval",
            "console.log(Oden.statSync('node_modules/@odentest/esm-basic').isDirectory)"
          ],
          "output": "true\n"
        }
      ]
    }
  }
}
