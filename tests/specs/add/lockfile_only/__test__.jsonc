{
  "tempDir": true,
  "steps": [
    {
      "args": "add --lockfile-only npm:@odentest/esm-basic",
      "output": "install.out"
    },
    {
      // Verify node_modules was not created. Also that the lockfile was created and contains the package
      "args": [
        "eval",
        "try { Oden.statSync('node_modules') } catch { console.log(true) } const lock = JSON.parse(Oden.readTextFileSync('oden.lock')); console.log(Object.keys(lock.npm).includes('@odentest/esm-basic@1.0.0'))"
      ],
      "output": "true\ntrue\n"
    },
    // now test remove
    {
      "args": "remove --lockfile-only npm:@odentest/esm-basic",
      "output": "remove.out"
    },
    {
      // Verify node_modules was not created. Also that the lockfile does not contain the npm package anymore
      "args": [
        "eval",
        "try { Oden.statSync('node_modules') } catch { console.log(true) } const lock = JSON.parse(Oden.readTextFileSync('oden.lock')); console.log(lock.npm == null)"
      ],
      "output": "true\ntrue\n"
    }
  ]
}
