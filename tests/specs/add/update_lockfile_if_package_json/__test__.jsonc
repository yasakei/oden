{
  "tempDir": true,
  "tests": {
    "updates_lockfile": {
      "steps": [
        {
          "args": "add npm:@odentest/esm-basic npm:@odentest/say-hello",
          "output": "add.out"
        },
        {
          "args": [
            "eval",
            "console.log(Oden.readTextFileSync('oden.lock'))"
          ],
          "output": "lockfile_add.out"
        },
        {
          "args": "remove @odentest/esm-basic @odentest/say-hello",
          "output": "remove.out"
        },
        {
          "args": [
            "eval",
            "console.log(Oden.readTextFileSync('oden.lock'))"
          ],
          "output": "lockfile_remove.out"
        }
      ]
    }
  }
}
