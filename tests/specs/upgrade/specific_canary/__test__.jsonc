{
  "if": "unix",
  "tempDir": true,
  "steps": [
    {
      "args": "eval Oden.copyFileSync(Oden.execPath(),'./oden_copy');",
      "exitCode": 0,
      "output": ""
    },
    {
      "commandName": "./oden_copy",
      "args": "run -A upgrade.ts",
      "output": "upgrade.out",
      "exitCode": 0,
      "flaky": true
    },
    {
      "commandName": "./oden_copy",
      "args": "--version",
      "exitCode": 0,
      "output": "version.out"
    }
  ]
}
