{
  "if": "notWindowsArm",
  "tempDir": true,
  "steps": [
    {
      "args": "eval Oden.copyFileSync(Oden.execPath(),'./oden_copy');",
      "exitCode": 0,
      "output": ""
    },
    {
      "commandName": "./oden_copy",
      "args": "upgrade --force --version 1.43.2 --output ./oden_copy2",
      "output": "upgrade.out",
      "exitCode": 0,
      "flaky": true
    },
    {
      "commandName": "./oden_copy",
      "args": ["eval", "if (Oden.version.oden === '1.43.2') { Oden.exit(1); }"],
      "exitCode": 0,
      "output": ""
    },
    {
      "commandName": "./oden_copy2",
      "args": "--version",
      "exitCode": 0,
      "output": "version.out"
    }
  ]
}
