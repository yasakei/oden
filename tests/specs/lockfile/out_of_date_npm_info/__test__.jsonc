{
  "tempDir": true,
  "envs": {
    "ODEN_DIR": "$PWD/oden_dir"
  },
  "steps": [
    {
      "args": "install",
      "output": "[WILDCARD]"
    },
    {
      "args": "run -A --no-lock ./rm-version.ts $PWD/oden_dir/npm/localhost_4260/@odentest/add/registry.json 1.0.0",
      "output": "[WILDCARD]"
    },
    {
      "args": "run -A --no-lock ./mv.ts ./oden.lock.old ./oden.lock",
      "output": ""
    },
    // trigger a lockfile update
    {
      "args": "install npm:chalk",
      "output": "[WILDCARD]"
    },
    {
      "args": "remove npm:chalk",
      "output": "[WILDCARD]"
    },
    {
      "args": [
        "eval",
        "--no-lock",
        "console.log(Oden.readTextFileSync('./oden.lock').trim())"
      ],
      "output": "oden.lock.out"
    }
  ]
}
