{
  "tempDir": true,
  "envs": {
    "ODEN_DIR": "$PWD/oden_dir"
  },
  "steps": [
    {
      "args": "install",
      "output": "[WILDCARD]"
    },
    {
      "args": "run -A --no-lock strip_links.ts ./oden.lock",
      "output": ""
    },
    {
      "args": "run -A --no-lock rm_packument.ts ./oden_dir/npm/localhost_4260/@odentest/esm-basic/registry.json",
      "output": ""
    },
    {
      "args": "run --cached-only main.ts",
      "output": "main.out"
    }
  ]
}
