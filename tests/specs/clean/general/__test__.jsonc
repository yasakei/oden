{
  "tempDir": true,
  "envs": {
    "ODEN_DIR": "$PWD/oden_dir"
  },
  "steps": [{
    // create oden dir
    "args": "run http://localhost:4545/echo.ts hi",
    "output": "[WILDCARD]"
  }, {
    "args": [
      "eval",
      "console.log(Oden.statSync('./oden_dir') != null)"
    ],
    "output": "true\n"
  }, {
    "args": "clean",
    "output": "Removed [WILDLINE]/oden_dir ([WILDCARD]files, [WILDCARD])\n"
  }, {
    "envs": {
      // use a new dir to avoid creating the old one
      "ODEN_DIR": "$PWD/other"
    },
    "args": "clean",
    "output": ""
  }, {
    "envs": {
      // use a new dir to avoid creating the old one
      "ODEN_DIR": "$PWD/other"
    },
    "args": [
      "eval",
      "try { Oden.statSync('./oden_dir') } catch (_) { console.log(true) }"
    ],
    "output": "true\n"
  }]
}
