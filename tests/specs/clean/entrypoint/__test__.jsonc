{
  "tempDir": true,

  "tests": {
    "npm": {
      "steps": [
        {
          "envs": { "ODEN_DIR": "./odendir" },
          "args": "install --node-modules-dir npm:chalk npm:@odentest/add",
          "output": "[WILDCARD]"
        },
        {
          "args": "run -A ./print-dir.ts --max-level=5 ./odendir --max-level=5 ./node_modules",
          "output": "npm_init.out"
        },
        {
          "envs": { "ODEN_DIR": "./odendir" },
          "args": "clean -e --node-modules-dir npm:@odentest/add",
          "output": "Removed [WILDCARD] files, [WILDCARD] from [WILDCARD]\n"
        },
        {
          "args": "run -A ./print-dir.ts --max-level=5 ./odendir --max-level=5 ./node_modules",
          "output": "npm_cleaned.out"
        },
        {
          "envs": { "ODEN_DIR": "./odendir" },
          "args": "install --node-modules-dir npm:chalk npm:@odentest/add",
          "output": "[WILDCARD]"
        },
        {
          "args": "run -A ./print-dir.ts --max-level=5 ./odendir --max-level=5 ./node_modules",
          "output": "npm_init.out"
        },
        {
          "envs": { "ODEN_DIR": "./odendir" },
          "args": "clean -e --node-modules-dir --dry-run npm:@odentest/add",
          "output": "npm_clean_dry_run.out"
        }
      ]
    },
    "jsr_http": {
      "steps": [
        {
          "envs": { "ODEN_DIR": "./odendir" },
          "args": "run -A jsr_http1.ts",
          "output": "[WILDCARD]"
        },
        {
          "args": "run -A ./print-dir.ts ./odendir",
          "output": "jsr_http_init.out"
        },
        {
          "envs": { "ODEN_DIR": "./odendir" },
          "args": "run -A jsr_http2.ts",
          "output": "[WILDCARD]"
        },
        {
          "envs": { "ODEN_DIR": "./odendir" },
          "args": "clean -e jsr_http2.ts",
          "output": "[WILDCARD]"
        },
        {
          "args": "run -A ./print-dir.ts ./odendir",
          "output": "jsr_http_cleaned.out"
        },
        {
          "envs": { "ODEN_DIR": "./odendir" },
          "args": "run -A jsr_http2.ts",
          "output": "" // nothing downloaded
        },
        {
          "args": "run -A ./print-dir.ts ./odendir",
          "output": "jsr_http_cleaned.out" // no new cache files
        }
      ]
    },
    "vendor": {
      "steps": [
        {
          "envs": { "ODEN_DIR": "./odendir" },
          "args": "run -A --node-modules-dir --vendor vendor1.ts",
          "output": "[WILDCARD]"
        },
        {
          "args": "run -A ./print-dir.ts ./odendir --max-level=5 ./node_modules ./vendor",
          "output": "vendor_init.out"
        },
        {
          "envs": { "ODEN_DIR": "./odendir" },
          "args": "clean -e --node-modules-dir --vendor vendor2.ts",
          "output": "vendor_clean_output.out"
        },
        {
          "args": "run -A ./print-dir.ts ./odendir --max-level=5 ./node_modules ./vendor",
          "output": "vendor_cleaned.out"
        }
      ]
    }
  }
}
