#[allow(non_camel_case_types)]
pub const fn op_async() -> ::oden_core::_ops::OpDecl {
    #[allow(non_camel_case_types)]
    pub struct op_async {
        _unconstructable: ::std::marker::PhantomData<()>,
    }
    impl ::oden_core::_ops::Op for op_async {
        const NAME: &'static str = stringify!(op_async);
        const DECL: ::oden_core::_ops::OpDecl = ::oden_core::_ops::OpDecl::new_internal_op2(
            ::oden_core::__op_name_fast!(op_async),
            true,
            false,
            false,
            2usize as u8,
            false,
            false,
            Self::v8_fn_ptr as _,
            Self::slow_function_impl,
            ::oden_core::AccessorType::None,
            None,
            None,
            ::oden_core::OpMetadata {
                ..::oden_core::OpMetadata::default()
            },
        );
    }
    impl op_async {
        pub const fn name() -> &'static str {
            <Self as oden_core::_ops::Op>::NAME
        }
        fn slow_function_impl<'s>(
            info: *const oden_core::v8::FunctionCallbackInfo,
        ) -> usize {
            let info: &'s _ = unsafe { &*info };
            #[cfg(debug_assertions)]
            let _reentrancy_check_guard = oden_core::_ops::reentrancy_check(
                &<Self as oden_core::_ops::Op>::DECL,
            );
            let parts: oden_core::v8::FunctionCallbackInfoParts<'s> = info.get_parts();
            let mut rv = parts.return_value;
            let args = oden_core::v8::FunctionCallbackArguments::from_function_callback_info_parts(
                info,
                &parts,
            );
            let opctx: &'s _ = unsafe {
                &*(oden_core::v8::Local::<
                    oden_core::v8::External,
                >::cast_unchecked(args.data())
                    .value() as *const oden_core::_ops::OpCtx)
            };
            let result = {
                let arg0 = args.get(1usize as i32);
                let Some(arg0) = oden_core::_ops::to_i32_option(&arg0) else {
                    oden_core::_ops::throw_error_one_byte_info(&info, "expected i32");
                    return 1;
                };
                let arg0 = arg0 as _;
                Self::call(arg0)
            };
            let promise_id = oden_core::_ops::to_i32_option(&args.get(0))
                .unwrap_or_default();
            if let Some(result) = oden_core::_ops::map_async_op_fallible(
                opctx,
                false,
                false,
                promise_id,
                result,
                |scope, result| { Ok(oden_core::_ops::RustToV8::to_v8(result, scope)) },
            ) {
                match result {
                    Ok(result) => {
                        oden_core::_ops::RustToV8RetVal::to_v8_rv(result, &mut rv)
                    }
                    Err(err) => {
                        let scope = ::std::pin::pin!(
                            unsafe { oden_core::v8::CallbackScope::new(info) }
                        );
                        let mut scope = scope.init();
                        let exception = oden_core::error::to_v8_error(&mut scope, &err);
                        scope.throw_exception(exception);
                        return 1;
                    }
                };
                return 0;
            }
            return 2;
        }
        extern "C" fn v8_fn_ptr(info: *const oden_core::v8::FunctionCallbackInfo) {
            Self::slow_function_impl(info);
        }
    }
    impl op_async {
        #[allow(clippy::too_many_arguments)]
        pub async fn call(x: i32) -> std::io::Result<i32> {
            Ok(x)
        }
    }
    <op_async as ::oden_core::_ops::Op>::DECL
}
