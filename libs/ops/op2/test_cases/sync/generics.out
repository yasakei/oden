#[allow(non_camel_case_types)]
pub const fn op_generics<T: Trait>() -> ::oden_core::_ops::OpDecl {
    #[allow(non_camel_case_types)]
    pub struct op_generics<T> {
        _unconstructable: ::std::marker::PhantomData<(T)>,
    }
    impl<T: Trait> ::oden_core::_ops::Op for op_generics<T> {
        const NAME: &'static str = stringify!(op_generics);
        const DECL: ::oden_core::_ops::OpDecl = ::oden_core::_ops::OpDecl::new_internal_op2(
            ::oden_core::__op_name_fast!(op_generics),
            false,
            false,
            false,
            0usize as u8,
            false,
            false,
            Self::v8_fn_ptr as _,
            Self::slow_function_impl,
            ::oden_core::AccessorType::None,
            Some({
                use oden_core::v8::fast_api::Type as CType;
                use oden_core::v8;
                oden_core::v8::fast_api::CFunction::new(
                    Self::v8_fn_ptr_fast as _,
                    &oden_core::v8::fast_api::CFunctionInfo::new(
                        CType::Void.as_info(),
                        &[CType::V8Value.as_info()],
                        oden_core::v8::fast_api::Int64Representation::BigInt,
                    ),
                )
            }),
            Some({
                use oden_core::v8::fast_api::Type as CType;
                use oden_core::v8;
                oden_core::v8::fast_api::CFunction::new(
                    Self::v8_fn_ptr_fast_metrics as _,
                    &oden_core::v8::fast_api::CFunctionInfo::new(
                        CType::Void.as_info(),
                        &[CType::V8Value.as_info(), CType::CallbackOptions.as_info()],
                        oden_core::v8::fast_api::Int64Representation::BigInt,
                    ),
                )
            }),
            ::oden_core::OpMetadata {
                ..::oden_core::OpMetadata::default()
            },
        );
    }
    impl<T: Trait> op_generics<T> {
        pub const fn name() -> &'static str {
            <Self as oden_core::_ops::Op>::NAME
        }
        #[allow(clippy::too_many_arguments)]
        extern "C" fn v8_fn_ptr_fast_metrics<'s>(
            this: oden_core::v8::Local<oden_core::v8::Object>,
            fast_api_callback_options: *mut oden_core::v8::fast_api::FastApiCallbackOptions<
                's,
            >,
        ) -> () {
            let fast_api_callback_options: &'s mut _ = unsafe {
                &mut *fast_api_callback_options
            };
            let opctx: &'s _ = unsafe {
                &*(oden_core::v8::Local::<
                    oden_core::v8::External,
                >::cast_unchecked(unsafe { fast_api_callback_options.data })
                    .value() as *const oden_core::_ops::OpCtx)
            };
            oden_core::_ops::dispatch_metrics_fast(
                opctx,
                oden_core::_ops::OpMetricsEvent::Dispatched,
            );
            let res = Self::v8_fn_ptr_fast(this);
            oden_core::_ops::dispatch_metrics_fast(
                opctx,
                oden_core::_ops::OpMetricsEvent::Completed,
            );
            res
        }
        #[allow(clippy::too_many_arguments)]
        extern "C" fn v8_fn_ptr_fast<'s>(
            this: oden_core::v8::Local<oden_core::v8::Object>,
        ) -> () {
            #[cfg(debug_assertions)]
            let _reentrancy_check_guard = oden_core::_ops::reentrancy_check(
                &<Self as oden_core::_ops::Op>::DECL,
            );
            let result = { Self::call() };
            result as _
        }
        fn slow_function_impl<'s>(
            info: *const oden_core::v8::FunctionCallbackInfo,
        ) -> usize {
            let info: &'s _ = unsafe { &*info };
            #[cfg(debug_assertions)]
            let _reentrancy_check_guard = oden_core::_ops::reentrancy_check(
                &<Self as oden_core::_ops::Op>::DECL,
            );
            let parts: oden_core::v8::FunctionCallbackInfoParts<'s> = info.get_parts();
            let mut rv = parts.return_value;
            let result = { Self::call() };
            oden_core::_ops::RustToV8RetVal::to_v8_rv(result, &mut rv);
            return 0;
        }
        extern "C" fn v8_fn_ptr(info: *const oden_core::v8::FunctionCallbackInfo) {
            Self::slow_function_impl(info);
        }
    }
    impl<T: Trait> op_generics<T> {
        #[allow(clippy::too_many_arguments)]
        pub fn call() {}
    }
    <op_generics<T> as ::oden_core::_ops::Op>::DECL
}

